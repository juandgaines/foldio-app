{
  "project": {
    "name": "Foldio",
    "description": "Encrypted, offline-first file app for Android and iOS, built from one shared KMP codebase."
  },
  "elements": [
    { "id": "user", "name": "User", "kind": "person", "status": "given",
      "description": "Stores, opens and edits private files on phone and tablet", "source": "REQUIREMENTS.md R1" },
    { "id": "foldio", "name": "Foldio", "kind": "system", "status": "given",
      "description": "Encrypts every file on the device before upload; reading works offline", "source": "REQUIREMENTS.md R1" },
    { "id": "api", "name": "Foldio API", "kind": "external", "status": "given",
      "description": "Auth, file metadata, chunked upload sessions, live events", "source": "API.md" },
    { "id": "object-storage", "name": "Object storage", "kind": "external", "status": "given",
      "description": "Serves ciphertext through presigned download URLs", "source": "API.md downloads" },
    { "id": "email", "name": "Email provider", "kind": "external", "status": "given",
      "description": "Sends verification and password-change emails", "source": "API.md /auth/verify" },
    { "id": "doc-picker", "name": "OS document picker", "kind": "external", "status": "given",
      "description": "Lets the user pick files to upload", "source": "REQUIREMENTS.md Upload" },
    { "id": "other-apps", "name": "Other apps", "kind": "external", "status": "given",
      "description": "Viewers and editors that open or edit Foldio files", "source": "REQUIREMENTS.md Hand-off" },

    { "id": "android", "platform": "android", "name": "Android app", "kind": "container", "parent": "foldio", "status": "given",
      "tech": "Kotlin, Compose, shared KMP", "description": "UI and shared logic on Android" },
    { "id": "ios", "platform": "ios", "name": "iOS app", "kind": "container", "parent": "foldio", "status": "given",
      "tech": "iOS app, shared KMP", "description": "UI and shared logic on iOS" },
    { "id": "android-runner", "platform": "android", "name": "Background runner (Android)", "kind": "container", "parent": "foldio", "status": "given",
      "tech": "WorkManager", "description": "Runs uploads and downloads after a kill or a reboot", "source": "REQUIREMENTS.md Reliability" },
    { "id": "ios-runner", "platform": "ios", "name": "Background runner (iOS)", "kind": "container", "parent": "foldio", "status": "open",
      "tech": "Open: background URLSession or BGContinuedProcessingTask", "description": "Runs transfers while the app is in the background",
      "notes": "Decision stop D9" },
    { "id": "local-db", "name": "Local database", "kind": "store", "parent": "foldio", "status": "given",
      "tech": "SQLCipher", "description": "Metadata, names (encrypted), upload queue", "source": "REQUIREMENTS.md Security" },
    { "id": "file-store", "name": "File store", "kind": "store", "parent": "foldio", "status": "open",
      "tech": "App-private storage", "description": "Areas: look-once cache, pinned, upload staging, edit copy",
      "notes": "Directories and eviction: decision stop D11" },
    { "id": "secure-storage", "name": "Secure key storage", "kind": "store", "parent": "foldio", "status": "given",
      "tech": "Android Keystore, iOS Keychain", "description": "Hardware-backed keys, biometric-wrapped master key", "source": "REQUIREMENTS.md Security" },
    { "id": "android-bridge", "platform": "android", "name": "Bridge to other apps (Android)", "kind": "container", "parent": "foldio", "status": "open",
      "tech": "ContentProvider, proxy file descriptor", "description": "Streams decrypted bytes to another app" },
    { "id": "ios-bridge", "platform": "ios", "name": "Bridge to other apps (iOS)", "kind": "container", "parent": "foldio", "status": "conflict",
      "tech": "QuickLook", "description": "Shows a preview of a decrypted file", "notes": "Q2: QuickLook needs a file on disk" },

    { "id": "crypto-core", "name": "Crypto core", "kind": "component", "parent": "android", "status": "open",
      "description": "Argon2id, AES-256-GCM chunks, key wrapping" },
    { "id": "vault", "name": "Vault", "kind": "component", "parent": "android", "status": "open",
      "description": "Holds the master key in memory, wipes it on lock" },
    { "id": "upload-engine", "name": "Upload engine", "kind": "component", "parent": "android", "status": "open",
      "description": "Stages ciphertext, runs the 5-step upload" }
  ],
  "relations": [
    { "from": "user", "to": "android", "label": "Uses" },
    { "from": "user", "to": "ios", "label": "Uses" },
    { "from": "android", "to": "api", "label": "Auth, metadata, events", "tech": "HTTPS, SSE" },
    { "from": "ios", "to": "api", "label": "Auth, metadata, events", "tech": "HTTPS, SSE" },
    { "from": "android-runner", "to": "api", "label": "Uploads chunks", "tech": "HTTPS" },
    { "from": "ios-runner", "to": "api", "label": "Uploads chunks", "tech": "HTTPS" },
    { "from": "android", "to": "object-storage", "label": "Downloads ciphertext", "tech": "presigned URL" },
    { "from": "ios", "to": "object-storage", "label": "Downloads ciphertext", "tech": "presigned URL" },
    { "from": "api", "to": "email", "label": "Sends verification mail" },
    { "from": "android", "to": "doc-picker", "label": "Picks files" },
    { "from": "ios", "to": "doc-picker", "label": "Picks files" },
    { "from": "android", "to": "local-db", "label": "Reads and writes metadata" },
    { "from": "ios", "to": "local-db", "label": "Reads and writes metadata" },
    { "from": "android", "to": "file-store", "label": "Reads and writes ciphertext" },
    { "from": "ios", "to": "file-store", "label": "Reads and writes ciphertext" },
    { "from": "android-runner", "to": "file-store", "label": "Reads staged ciphertext" },
    { "from": "ios-runner", "to": "file-store", "label": "Reads staged ciphertext" },
    { "from": "android", "to": "secure-storage", "label": "Wraps and unwraps keys" },
    { "from": "ios", "to": "secure-storage", "label": "Wraps and unwraps keys" },
    { "from": "android", "to": "android-bridge", "label": "Grants read access" },
    { "from": "ios", "to": "ios-bridge", "label": "Hands a file" },
    { "from": "android-bridge", "to": "other-apps", "label": "Streams decrypted bytes" },
    { "from": "ios-bridge", "to": "other-apps", "label": "Shows a preview" },
    { "from": "android", "to": "android-runner", "label": "Schedules transfers" },
    { "from": "ios", "to": "ios-runner", "label": "Schedules transfers" },
    { "from": "vault", "to": "secure-storage", "label": "Unwraps the master key" },
    { "from": "upload-engine", "to": "crypto-core", "label": "Encrypts chunks" },
    { "from": "crypto-core", "to": "vault", "label": "Gets the master key" },
    { "from": "upload-engine", "to": "file-store", "label": "Writes staging" },
    { "from": "upload-engine", "to": "api", "label": "Initiate, chunks, complete" }
  ],
  "zones": [
    { "id": "memory", "name": "App memory" },
    { "id": "app-storage", "name": "App storage" },
    { "id": "secure-hw", "name": "Keystore or Keychain" },
    { "id": "other-apps", "name": "Other apps" },
    { "id": "user-storage", "name": "User-visible storage" },
    { "id": "server", "name": "Foldio server" },
    { "id": "backup", "name": "OS backup" }
  ],
  "data": [
    { "id": "password", "name": "Password", "status": "given", "source": "REQUIREMENTS.md Security",
      "locations": [ { "zone": "memory", "plaintext": true, "survivesDeath": false, "backgroundAccess": false } ] },
    { "id": "master-key", "name": "Master key", "status": "given", "source": "REQUIREMENTS.md Security",
      "locations": [
        { "zone": "memory", "plaintext": true, "survivesDeath": false, "backgroundAccess": false },
        { "zone": "secure-hw", "plaintext": false, "survivesDeath": true, "backgroundAccess": false, "notes": "Biometric-wrapped copy" },
        { "zone": "server", "plaintext": false, "survivesDeath": true, "notes": "wrappedMasterKey: IV, ciphertext, tag" }
      ] },
    { "id": "auth-key", "name": "authKey", "status": "given", "source": "API.md /auth/login",
      "locations": [ { "zone": "memory", "plaintext": true, "survivesDeath": false } ] },
    { "id": "tokens", "name": "Access and refresh tokens", "status": "open", "source": "REQUIREMENTS.md Sessions",
      "locations": [ { "zone": "app-storage", "plaintext": false, "survivesDeath": true, "backgroundAccess": true, "notes": "Storage and refresh: decision stop D5" } ] },
    { "id": "dek", "name": "DEK (per version)", "status": "given", "source": "REQUIREMENTS.md Security",
      "locations": [
        { "zone": "memory", "plaintext": true, "survivesDeath": false },
        { "zone": "server", "plaintext": false, "survivesDeath": true, "notes": "wrappedDek, wrapped under the master key" }
      ] },
    { "id": "file-content", "name": "File content", "status": "given", "source": "REQUIREMENTS.md Security",
      "locations": [
        { "zone": "memory", "plaintext": true, "survivesDeath": false },
        { "zone": "app-storage", "plaintext": false, "survivesDeath": true, "backgroundAccess": true },
        { "zone": "server", "plaintext": false, "survivesDeath": true },
        { "zone": "user-storage", "plaintext": true, "survivesDeath": true, "notes": "Only the user's Download action" }
      ] },
    { "id": "file-names", "name": "File and folder names", "status": "given", "source": "REQUIREMENTS.md Security",
      "locations": [
        { "zone": "app-storage", "plaintext": false, "survivesDeath": true, "notes": "Encrypted in SQLCipher" },
        { "zone": "server", "plaintext": true, "survivesDeath": true, "notes": "Names and paths are plaintext on the server" }
      ] }
  ],
  "crossings": [
    { "from": "memory", "to": "server", "data": ["auth-key"], "allowed": true, "status": "given",
      "rule": "Only SHA-256 of an Argon2id output", "source": "API.md /auth/login" },
    { "from": "memory", "to": "server", "data": ["password"], "allowed": false, "status": "given",
      "rule": "The password never leaves the device", "source": "REQUIREMENTS.md Security" },
    { "from": "memory", "to": "app-storage", "data": ["master-key"], "allowed": false, "status": "given",
      "rule": "Never written to disk in plaintext", "source": "REQUIREMENTS.md Authentication" },
    { "from": "memory", "to": "app-storage", "data": ["file-content"], "allowed": true, "status": "given",
      "rule": "Only ciphertext", "source": "REQUIREMENTS.md Upload, Download" },
    { "from": "memory", "to": "other-apps", "data": ["file-content"], "allowed": true, "status": "conflict",
      "rule": "Read-only; no plaintext on disk (Q2: QuickLook needs a file)", "source": "REQUIREMENTS.md Hand-off" },
    { "from": "memory", "to": "user-storage", "data": ["file-content"], "allowed": true, "status": "given",
      "rule": "Only through the user's Download action", "source": "REQUIREMENTS.md Download" },
    { "from": "app-storage", "to": "server", "data": ["file-content", "file-names"], "allowed": true, "status": "given",
      "rule": "Content as ciphertext; names in plaintext", "source": "API.md upload" },
    { "from": "app-storage", "to": "backup", "data": ["file-content", "file-names", "tokens"], "allowed": false, "status": "given",
      "rule": "All on-disk data is excluded from backups", "source": "REQUIREMENTS.md Security" }
  ],
  "responsibilities": [
    { "concern": "Derive keys from the password", "owner": "client", "status": "given", "source": "REQUIREMENTS.md Security" },
    { "concern": "Set the KDF parameters", "owner": "server", "status": "given", "source": "API.md /auth/params" },
    { "concern": "Verify authKey", "owner": "server", "status": "given", "source": "API.md /auth/login" },
    { "concern": "Encrypt and decrypt file content", "owner": "client", "status": "given", "source": "REQUIREMENTS.md Security" },
    { "concern": "Detect name collisions", "owner": "server", "status": "given", "source": "API.md 409 FILE_DUPLICATE_NAME" },
    { "concern": "Detect version conflicts", "owner": "server", "status": "given", "source": "API.md baseVersionId" },
    { "concern": "Resolve conflicts (Keep Mine, Keep Both, Use Server)", "owner": "client", "status": "given", "source": "REQUIREMENTS.md Conflicts" },
    { "concern": "Enforce quota", "owner": "server", "status": "given", "source": "API.md STORAGE_QUOTA_EXCEEDED" },
    { "concern": "Copy and restore versions", "owner": "server", "status": "given", "source": "API.md /copy, /restore" },
    { "concern": "Cap pinned refresh at 500 MB a day", "owner": "client", "status": "given", "source": "REQUIREMENTS.md Reliability" },
    { "concern": "Resume transfers after a reboot", "owner": "os", "status": "given", "source": "REQUIREMENTS.md Reliability",
      "notes": "WorkManager on Android; iOS runner is open (D9)" },
    { "concern": "Refresh tokens one caller at a time", "owner": "client", "status": "open", "notes": "Decision stop D5" },
    { "concern": "Evict the look-once cache", "owner": "client", "status": "open", "notes": "Decision stop D11" }
  ]
}
